APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./storage/app.db
JWT_SECRET=this-is-a-local-development-secret-change-before-deploying-12345
GEMINI_API_KEY=""
